# ---------------------------------------------------------------------------
# RERA Property Platform — environment template.
#
# Copy to .env and adjust. Never commit a real .env: it holds live credentials.
#   cp .env.example .env
#
# Every value below has a development-friendly default in the application, so a
# local run works with this file unchanged. Production is stricter: the server
# refuses to start unless JWT_SECRET, DB_PASSWORD and ADMIN_PASSWORD are set to
# real values, CORS_ORIGINS is not a wildcard and SEED_DEMO_DATA is false.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=RERA Property Platform
APP_ENV=development                     # development | production
APP_URL=http://localhost:8080           # public URL of this API
FRONTEND_URL=http://localhost:5173      # public URL of the SPA (used in emails, sitemap, share links)
PORT=8080
SERVER_READ_TIMEOUT=30
SERVER_WRITE_TIMEOUT=60

# --- MySQL -----------------------------------------------------------------
# Inside Docker Compose the host is the service name (mysql), not localhost.
DB_HOST=localhost
DB_PORT=3306
DB_USER=rera
DB_PASSWORD=change-me
DB_NAME=rera_properties
DB_AUTO_MIGRATE=true                    # create/update tables on startup
DB_SEED=true                            # load roles, admin, cities, amenities, pages

# Used by the MySQL container only.
MYSQL_ROOT_PASSWORD=change-me-root

# --- Redis -----------------------------------------------------------------
# Redis is optional: if it is unreachable the platform keeps serving, with
# caching and rate limiting falling back to in-process behaviour.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Authentication --------------------------------------------------------
JWT_SECRET=change-me-in-production-min-32-chars
JWT_ACCESS_TTL=15                       # minutes
JWT_REFRESH_TTL=7                       # days
JWT_ISSUER=rera-property-platform

OTP_TTL=300                             # seconds a code stays valid
OTP_MAX_ATTEMPTS=5                      # verification attempts per code

# --- First administrator ---------------------------------------------------
# Created once, on the first seeded startup. Change the password before any
# deployment that is reachable from outside your machine.
ADMIN_EMAIL=admin@reraproperties.local
ADMIN_PASSWORD=Admin@12345
ADMIN_MOBILE=9000000001

# Sample builders, projects and a demo buyer. Must be false in production.
SEED_DEMO_DATA=true

# --- CORS ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_AUTH=10                      # login/register requests per minute per caller
RATE_LIMIT_OTP=20                       # OTP requests per hour per caller
RATE_LIMIT_PUBLIC=120                   # public API requests per minute per caller

# --- File storage ----------------------------------------------------------
# The application depends on a Storage interface; switching provider is a
# configuration change plus one case in buildStorage().
STORAGE_DRIVER=local                    # local | s3
STORAGE_LOCAL_DIR=./uploads
STORAGE_BASE_URL=http://localhost:8080/uploads

S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

# --- Email -----------------------------------------------------------------
# The "log" driver prints OTP codes and alerts to the server log, which is what
# you want locally. Switch to smtp with real credentials to actually deliver.
# Gmail: host smtp.gmail.com, port 587, and an App Password (not the account
# password) from https://myaccount.google.com/apppasswords. MAIL_FROM must
# match MAIL_USERNAME.
MAIL_DRIVER=log                         # log | smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=RERA Property Platform

# --- SMS and WhatsApp ------------------------------------------------------
# No vendor is hard-coded: implement notification.Sender and register it in
# buildNotifier() to plug one in.
# --- Rental marketplace -------------------------------------------------------
# How long a new rental listing stays live before the owner must renew it.
# Sale listings never expire.
RENTAL_LISTING_DAYS=60
# How often stale rentals are retired and owners of lapsing listings warned.
# 0 switches the timer off, leaving the administrator trigger as the only way to
# run the sweep.
RENTAL_SWEEP_INTERVAL_HOURS=6

SMS_DRIVER=log
WHATSAPP_DRIVER=log
WHATSAPP_NUMBER=                        # fallback number when a builder has none
WHATSAPP_COUNTRY_CODE=91

# --- Frontend (Vite) -------------------------------------------------------
# Read at build time by the SPA; must be reachable from the browser.
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_NAME=RERA Property Platform
